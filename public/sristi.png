<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 520" width="400" height="520">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2d1b22"/>
      <stop offset="50%" stop-color="#1f1824"/>
      <stop offset="100%" stop-color="#0d1117"/>
    </linearGradient>
    <linearGradient id="topGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#802636"/>
      <stop offset="100%" stop-color="#541722"/>
    </linearGradient>
    <linearGradient id="bagGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#e0b84c"/>
      <stop offset="50%" stop-color="#e0b84c"/>
      <stop offset="50.1%" stop-color="#4a7eb0"/>
      <stop offset="100%" stop-color="#345c85"/>
    </linearGradient>
    <linearGradient id="hairGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1c1619"/>
      <stop offset="100%" stop-color="#0a0809"/>
    </linearGradient>
    <linearGradient id="skinGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f5c29b"/>
      <stop offset="100%" stop-color="#d99b73"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000" flood-opacity="0.5"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="400" height="520" fill="url(#bg)"/>
  <rect x="20" y="20" width="360" height="480" rx="16" fill="none" stroke="#30363d" stroke-width="2"/>

  <!-- Subtle Bokeh/Aesthetic Ambient -->
  <circle cx="80" cy="100" r="60" fill="#802636" opacity="0.15" filter="blur(20px)"/>
  <circle cx="320" cy="180" r="70" fill="#58a6ff" opacity="0.1" filter="blur(25px)"/>

  <!-- Character Illustration: Sristi Sharma -->
  <g filter="url(#shadow)">
    <!-- Hair Back -->
    <path d="M 120 180 C 110 120, 290 120, 280 180 C 290 260, 310 320, 280 380 C 250 400, 150 400, 120 380 C 90 320, 110 260, 120 180 Z" fill="url(#hairGrad)"/>

    <!-- Shoulders / Burgundy Top -->
    <path d="M 130 310 C 140 290, 170 280, 200 280 C 230 280, 260 290, 270 310 L 290 420 L 110 420 Z" fill="url(#topGrad)"/>
    <!-- Sweetheart neckline detail -->
    <path d="M 160 285 Q 200 305 240 285 Q 200 325 160 285 Z" fill="url(#skinGrad)" opacity="0.9"/>

    <!-- Neck -->
    <rect x="180" y="235" width="40" height="55" rx="10" fill="url(#skinGrad)"/>

    <!-- Face Oval -->
    <ellipse cx="200" cy="195" rx="42" ry="52" fill="url(#skinGrad)"/>

    <!-- Hair Front & Waves -->
    <path d="M 158 185 C 150 140, 180 135, 200 135 C 230 135, 250 150, 245 185 C 240 160, 210 150, 200 155 C 185 150, 165 160, 158 185 Z" fill="url(#hairGrad)"/>
    <path d="M 158 185 C 140 210, 145 270, 135 320 C 150 300, 160 250, 165 210 Z" fill="url(#hairGrad)"/>
    <path d="M 242 185 C 260 210, 255 270, 265 320 C 250 300, 240 250, 235 210 Z" fill="url(#hairGrad)"/>

    <!-- Eyebrows -->
    <path d="M 172 180 Q 185 174 193 180" stroke="#221510" stroke-width="2.5" stroke-linecap="round" fill="none"/>
    <path d="M 207 180 Q 215 174 228 180" stroke="#221510" stroke-width="2.5" stroke-linecap="round" fill="none"/>

    <!-- Eyes -->
    <ellipse cx="183" cy="190" rx="6" ry="4" fill="#2d1c16"/>
    <ellipse cx="217" cy="190" rx="6" ry="4" fill="#2d1c16"/>
    <circle cx="185" cy="189" r="1.5" fill="#fff"/>
    <circle cx="219" cy="189" r="1.5" fill="#fff"/>

    <!-- Clear Glasses Frames (Signature) -->
    <rect x="168" y="180" width="28" height="22" rx="6" fill="rgba(255,255,255,0.15)" stroke="#e6edf3" stroke-width="2"/>
    <rect x="204" y="180" width="28" height="22" rx="6" fill="rgba(255,255,255,0.15)" stroke="#e6edf3" stroke-width="2"/>
    <line x1="196" y1="188" x2="204" y2="188" stroke="#e6edf3" stroke-width="2"/>
    <line x1="168" y1="188" x2="160" y2="185" stroke="#e6edf3" stroke-width="1.5"/>
    <line x1="232" y1="188" x2="240" y2="185" stroke="#e6edf3" stroke-width="1.5"/>

    <!-- Warm Smile -->
    <path d="M 188 218 Q 200 228 212 218" stroke="#a84332" stroke-width="3" stroke-linecap="round" fill="none"/>

    <!-- Cream Pants / Lower Body -->
    <path d="M 120 410 L 280 410 L 290 510 L 110 510 Z" fill="#f0ebe1"/>

    <!-- Tote Bag (Yellow & Blue) -->
    <rect x="225" y="380" width="55" height="85" rx="4" fill="url(#bagGrad)" filter="url(#shadow)"/>
    <path d="M 238 380 L 238 340 M 267 380 L 267 340" stroke="#345c85" stroke-width="3" fill="none"/>
  </g>

  <!-- Title Badge -->
  <rect x="110" y="465" width="180" height="28" rx="14" fill="#161b22" stroke="#58a6ff" stroke-width="1.5"/>
  <text x="200" y="483" text-anchor="middle" fill="#58a6ff" font-family="monospace" font-size="12" font-weight="bold">SRISTI SHARMA • SDE</text>
</svg>